# ==========================================
# FULL-STACK SYSTEM ENVIRONMENT CONFIGURATION
# ==========================================

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Security & Secrets (MUST BE CHANGED IN PRODUCTION)
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY=super-secret-jwt-key-change-this-in-production-32-chars-min
JWT_REFRESH_SECRET_KEY=super-secret-refresh-key-change-this-in-production-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider API Configuration
AI_PROVIDER=auto
BREETH_API_KEY=your-breeth-ai-api-key-here
BREETH_API_URL=https://api.breeth.ai/v1/chat/completions
GEMINI_API_KEY=your-gemini-api-key-here

# Security Headers & CORS
# Comma-separated allowed origins for FastAPI backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# Database Configuration
# Default: Async SQLite for local development. For PostgreSQL use: postgresql+asyncpg://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./backend_app.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Frontend Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000/api/v1
